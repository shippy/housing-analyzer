# Prague Housing Analyzer - Default Scenario Configuration
# Copy this file to .env and update with your personal values.
# The .env file is gitignored to protect your financial privacy.

# =============================================================================
# PROPERTY PARAMETERS
# =============================================================================

# Property price in CZK
PROPERTY_PRICE=15000000

# Down payment in CZK (typically 10-30% of property price)
DOWN_PAYMENT=3000000

# Prague district for appreciation adjustment
# Options: prague_avg, prague_1, prague_2, ..., prague_10
# Prague 1-2 tend to appreciate faster, Prague 9-10 slower
DISTRICT=prague_avg

# =============================================================================
# YOUR SITUATION
# =============================================================================

# Your current monthly rent as a tenant (CZK)
MONTHLY_RENT=25000

# USD investment holdings you would liquidate for down payment
USD_HOLDINGS=100000

# Analysis time horizon in years
YEARS=10

# Expected annual rent inflation (decimal: 0.03 = 3%)
RENT_INFLATION=0.03

# =============================================================================
# BUY-TO-LET MODE (Optional)
# =============================================================================
# Instead of living in the purchased property, rent it out and continue
# living in a (potentially cheaper) rental yourself.

# Enable buy-to-let mode (true/false)
BUY_TO_LET=false

# Gross rental yield: annual rent / property value
# Prague typical range: 2-3% for central, 3-4% for outer districts
RENTAL_YIELD=0.025

# Landlord expense rate as fraction of gross rent
# Includes: vacancy (5-10%), maintenance (5-10%), management (10-15%), taxes (15%)
# Conservative estimate: 30%
BTL_EXPENSE_RATE=0.30

# =============================================================================
# FX OUTLOOK (Optional)
# =============================================================================
# If you're bearish on USD, enable the mixture model to incorporate your view.
# Each simulation path is assigned to either "weak dollar" or "stable" regime.

# Enable FX mixture model (true/false)
# If false, uses historical USD/CZK drift from data
FX_MIXTURE_ENABLED=false

# Probability of weak dollar regime (0.0 to 1.0)
FX_WEAK_DOLLAR_PROB=0.6

# Annual drift in weak dollar regime (negative = USD weakens)
FX_WEAK_DOLLAR_DRIFT=-0.04

# Annual drift in stable/strong dollar regime
FX_STABLE_DRIFT=0.01
